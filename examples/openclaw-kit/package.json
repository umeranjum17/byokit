{
  "name": "byokit-openclaw-kit-example",
  "private": true,
  "description": "Your ChatGPT plan working for you on this computer, from a phone browser: pair, sign in, send a message, allow what it asks.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "npm run build:web",
    "start": "node host.ts",
    "build:web": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=web/app.js --log-level=warning",
    "test": "node --test e2e.test.ts"
  },
  "dependencies": {
    "@byokit/pair": "0.9.0",
    "@byokit/openclaw": "0.9.0",
    "@byokit/discover": "0.6.0",
    "@byokit/relay": "0.6.0",
    "@byokit/seal": "0.3.0",
    "@byokit/ui": "0.6.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
