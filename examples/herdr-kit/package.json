{
  "name": "byokit-herdr-kit-example",
  "private": true,
  "description": "Drive Herdr on this computer from a phone browser: pair, start an agent, prompt it, answer its questions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "npm run build:web",
    "start": "node host.ts",
    "build:web": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=web/app.js --log-level=warning",
    "test": "node --test e2e.test.ts"
  },
  "dependencies": {
    "@byokit/herdr": "0.16.2",
    "@byokit/pair": "0.10.4",
    "@byokit/discover": "0.8.4",
    "@byokit/relay": "0.8.2",
    "@byokit/seal": "0.3.1",
    "@byokit/ui": "0.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
