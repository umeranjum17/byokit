  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "b4a": "1.9.0",
    "noise-handshake": "4.2.0",
    "sodium-javascript": "0.8.0",
