{
  "name": "@byokit/usage",
  "version": "0.10.0",
  "description": "Typed TypeScript kits for apps using the AI plans and devices people already have.",
  "homepage": "https://github.com/umeranjum17/byokit#usage",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/usage"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn.d.ts",
        "default": "./dist/rn.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./react-native": {
      "types": "./dist/rn.d.ts",
      "default": "./dist/rn.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "default": "./dist/view.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./version/node": {
      "types": "./dist/version-node.d.ts",
      "default": "./dist/version-node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
