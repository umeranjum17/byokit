{
  "name": "@byokit/secrets",
  "version": "0.2.0",
  "description": "One secret per name: OS keyring, sealed files, Expo SecureStore, encrypted web storage, or host-passed overrides.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/secrets"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn.d.ts",
        "default": "./dist/rn.js"
      },
      "browser": {
        "types": "./dist/web.d.ts",
        "default": "./dist/web.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/rn.d.ts",
      "default": "./dist/rn.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/seal": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "expo-secure-store": "57.0.4",
    "fake-indexeddb": "6.2.5"
  },
  "peerDependencies": {
    "expo-secure-store": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    }
  }
}
