{
  "name": "@byokit/statusbar",
  "version": "0.1.2",
  "description": "Typed TypeScript kits for apps using the AI plans and devices people already have.",
  "homepage": "https://github.com/umeranjum17/byokit#statusbar",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "deprecated": "New home: @platform-kits/statusbar. New work goes there.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/statusbar"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn.d.ts",
        "default": "./dist/rn.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "android",
    "!android/build",
    "expo-module.config.json",
    "app.plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "expo-modules-core": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "expo-modules-core": "58.0.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
