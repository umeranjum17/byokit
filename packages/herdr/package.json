{
  "name": "@byokit/herdr",
  "version": "0.1.4",
  "description": "Drive the Herdr on this computer — workspaces, tabs, panes, agents and blocked-approval answers — from an app, or hand it to a phone over @byokit/link.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/herdr"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./binary": {
      "types": "./dist/binary.d.ts",
      "default": "./dist/binary.js"
    },
    "./device": {
      "react-native": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "browser": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "dependencies": {
    "@byokit/link": "0.3.2",
    "@byokit/relay": "0.2.1",
    "@byokit/reach": "0.3.0",
    "@byokit/seal": "0.2.0",
    "ws": "8.21.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
