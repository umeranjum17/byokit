{
  "name": "@byokit/herdr",
  "version": "0.14.0",
  "description": "Drive the Herdr on this computer — workspaces, tabs, panes, agents and blocked-approval answers — from an app, or hand it to a phone over @byokit/pair.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/herdr"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./binary": {
      "types": "./dist/binary.d.ts",
      "default": "./dist/binary.js"
    },
    "./device": {
      "react-native": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "browser": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "peerDependencies": {
    "@byokit/discover": "0.8.4",
    "@byokit/pair": "0.10.3",
    "@byokit/relay": "0.8.1"
  },
  "peerDependenciesMeta": {
    "@byokit/discover": {
      "optional": true
    },
    "@byokit/pair": {
      "optional": true
    },
    "@byokit/relay": {
      "optional": true
    }
  },
  "dependencies": {
    "@byokit/seal": "0.3.1",
    "ws": "8.22.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
