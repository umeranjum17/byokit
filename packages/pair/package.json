{
  "name": "@byokit/pair",
  "version": "0.10.5",
  "description": "TypeScript kits that let people sign in to your app with the AI plans they already pay for, on web, phone and desktop.",
  "homepage": "https://github.com/umeranjum17/byokit#pair",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/pair"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "b4a": "1.9.0",
    "noise-handshake": "4.2.0",
    "sodium-javascript": "0.8.0",
    "sodium-native": "5.2.0",
    "sodium-universal": "5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
