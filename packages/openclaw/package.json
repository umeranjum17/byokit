{
  "name": "@byokit/openclaw",
  "version": "0.1.3",
  "description": "The OpenClaw runtime kit: the pinned engine's full operator surface with plain-words helpers for members, sign-in, runs and approvals.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/openclaw"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "react-native": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "browser": {
        "types": "./dist/device.d.ts",
        "default": "./dist/device.js"
      },
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "engine",
    "plugin",
    "policy",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "dependencies": {
    "@byokit/link": "0.4.0",
    "@byokit/relay": "0.2.2",
    "@byokit/reach": "0.3.0",
    "@byokit/seal": "0.2.0",
    "@openclaw/gateway-client": "2026.8.1",
    "@openclaw/gateway-protocol": "2026.8.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@byokit/ui-core": "0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
