{
  "name": "@byokit/decide",
  "version": "0.16.3",
  "description": "TypeScript kits that let people sign in to your app with the AI plans they already pay for, on web, phone and desktop.",
  "homepage": "https://github.com/umeranjum17/byokit#decide",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/decide"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code.d.ts",
      "default": "./dist/claude-code.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "default": "./dist/codex.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "default": "./dist/pi.js"
    },
    "./slim": {
      "types": "./dist/slim.d.ts",
      "default": "./dist/slim.js"
    }
  },
  "bin": {
    "byokit-eval": "dist/cli.js"
  },
  "files": [
    "dist",
    "evals",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@byokit/accounts": "0.34.0",
    "openai": "7.43.0",
    "@byokit/pair": "0.10.5"
  },
  "peerDependenciesMeta": {
    "@byokit/accounts": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@byokit/pair": {
      "optional": true
    }
  },
  "devDependencies": {
    "openai": "7.43.0"
  }
}
