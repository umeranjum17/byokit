{
  "name": "@byokit/decide",
  "version": "0.13.1",
  "description": "Typed questions in, a typed answer with confidence out, abstaining below a floor. Rules, Jev and configurable OpenAI backends, and an eval runner.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/decide"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval.d.ts",
      "default": "./dist/eval.js"
    },
    "./claude-code": {
      "types": "./dist/claude-code.d.ts",
      "default": "./dist/claude-code.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "default": "./dist/codex.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "default": "./dist/pi.js"
    },
    "./slim": {
      "types": "./dist/slim.d.ts",
      "default": "./dist/slim.js"
    }
  },
  "bin": {
    "byokit-eval": "dist/cli.js"
  },
  "files": [
    "dist",
    "evals",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@byokit/accounts": "0.28.2",
    "openai": "7.25.0",
    "@byokit/pair": "0.10.4"
  },
  "peerDependenciesMeta": {
    "@byokit/accounts": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@byokit/pair": {
      "optional": true
    }
  },
  "devDependencies": {
    "openai": "7.25.0"
  }
}
