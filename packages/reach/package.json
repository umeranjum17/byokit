    ".": {
      "react-native": { "types": "./dist/rn.d.ts", "default": "./dist/rn.js" },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": { "prepack": "tsc -b" },
