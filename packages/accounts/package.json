{
  "name": "@byokit/accounts",
  "version": "0.22.0",
  "description": "Sign in with the AI plan you already pay for, into your app's own store.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/accounts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/portable.d.ts",
        "default": "./dist/portable.js"
      },
      "browser": {
        "types": "./dist/portable.d.ts",
        "default": "./dist/portable.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./isolate": {
      "types": "./dist/isolate.d.ts",
      "default": "./dist/isolate.js"
    },
    "./keys": {
      "react-native": {
        "types": "./dist/keys.d.ts",
        "default": "./dist/keys.js"
      },
      "browser": {
        "types": "./dist/keys.d.ts",
        "default": "./dist/keys.js"
      },
      "types": "./dist/node-keys.d.ts",
      "default": "./dist/node-keys.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./chatgpt-plan": {
      "types": "./dist/chatgpt-plan.d.ts",
      "default": "./dist/chatgpt-plan.js"
    },
    "./opencode-go": {
      "types": "./dist/opencode-go.d.ts",
      "default": "./dist/opencode-go.js"
    },
    "./ollama-pro": {
      "types": "./dist/ollama-pro.d.ts",
      "default": "./dist/ollama-pro.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@byokit/secrets": "0.5.1",
    "@byokit/usage": "0.8.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@google/genai": "2.21.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "openai": "7.19.0",
    "partial-json": "0.1.7",
    "undici-types": "7.16.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
