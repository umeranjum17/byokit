{
  "name": "@byokit/accounts",
  "version": "0.13.0",
  "description": "Sign in with the AI plan you already pay for, into your app's own store.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/accounts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/portable.d.ts",
        "default": "./dist/portable.js"
      },
      "browser": {
        "types": "./dist/portable.d.ts",
        "default": "./dist/portable.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./isolate": {
      "types": "./dist/isolate.d.ts",
      "default": "./dist/isolate.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./chatgpt-plan": {
      "types": "./dist/chatgpt-plan.d.ts",
      "default": "./dist/chatgpt-plan.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "NOTICE"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "dependencies": {
    "@byokit/usage": "0.2.0",
    "@earendil-works/pi-ai": "0.87.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
