{
  "name": "@byokit/overlay",
  "version": "0.3.1",
  "description": "TypeScript kits that let people sign in to your app with the AI plans they already pay for, on web, phone and desktop.",
  "homepage": "https://github.com/umeranjum17/byokit#overlay",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "deprecated": "New home: @platform-kits/overlay. New work goes there.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/overlay"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/deprecated-rn.d.ts",
        "default": "./dist/deprecated-rn.js"
      },
      "types": "./dist/deprecated.d.ts",
      "default": "./dist/deprecated.js"
    },
    "./focused-field": {
      "react-native": {
        "types": "./dist/deprecated-focused-field-rn.d.ts",
        "default": "./dist/deprecated-focused-field-rn.js"
      },
      "types": "./dist/deprecated-focused-field.d.ts",
      "default": "./dist/deprecated-focused-field.js"
    },
    "./screen-frame": {
      "react-native": {
        "types": "./dist/deprecated-screen-frame-rn.d.ts",
        "default": "./dist/deprecated-screen-frame-rn.js"
      },
      "types": "./dist/deprecated-screen-frame.d.ts",
      "default": "./dist/deprecated-screen-frame.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/bubble": "0.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
