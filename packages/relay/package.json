    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/pair": "0.10.5",
    "web-push": "3.6.7",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/web-push": "3.6.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
