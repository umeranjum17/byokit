{
  "name": "@byokit/endpoint",
  "version": "0.1.0",
  "description": "One loopback address that answers OpenAI and Anthropic web-format requests with the person's own API key, through a checksum-pinned CLIProxyAPI.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/endpoint"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/usage": "0.10.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
