{
  "name": "@byokit/discover",
  "version": "0.8.6",
  "description": "Typed TypeScript kits for apps using the AI plans and devices people already have.",
  "homepage": "https://github.com/umeranjum17/byokit#discover",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/discover"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn.d.ts",
        "default": "./dist/rn.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "android",
    "!android/build",
    "ios",
    "expo-module.config.json",
    "app.plugin.js"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/ui": "1.0.0",
    "bonjour-service": "^1.4.4",
    "react-native-zeroconf": "0.17.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo-modules-core": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo-modules-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "expo-modules-core": "58.0.15"
  }
}
