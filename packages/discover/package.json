{
  "name": "@byokit/discover",
  "version": "0.6.0",
  "description": "The addresses a phone can dial the home computer on. Tailscale Serve with ownership checks, direct tailnet, LAN, mDNS advertising (Node) and mDNS browsing (React Native).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/discover"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/rn.d.ts",
        "default": "./dist/rn.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react-native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "android",
    "!android/build",
    "ios",
    "expo-module.config.json"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "dependencies": {
    "@byokit/ui": "0.6.0",
    "bonjour-service": "^1.4.4",
    "react-native-zeroconf": "0.17.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo-modules-core": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "expo-modules-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "expo-modules-core": "57.0.19"
  }
}
