{
  "name": "@byokit/connect",
  "version": "0.8.0",
  "description": "Typed TypeScript kits for apps using the AI plans and devices people already have.",
  "homepage": "https://github.com/umeranjum17/byokit#connect",
  "keywords": ["typescript","ai","ai-sdk","react-native","web","privacy"],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/connect"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "prepack": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@byokit/secrets": "0.5.2",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "emulate": "0.12.2"
  }
}
