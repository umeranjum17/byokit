{
  "name": "@byokit/write",
  "version": "0.1.0",
  "private": true,
  "description": "Drafting in a person's voice: voice rules, platform limits, brief lines, model-free draft checks and thread splits over a pinned writing engine, plus an agent CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/write"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "bin": {
    "write": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "tsc -b && node ../../scripts/fix-words-dts.cjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
