{
  "name": "@byokit/machine",
  "version": "0.1.0",
  "private": true,
  "description": "The person's own always-on cloud computer for an app's host process: typed setup, install, cost and words.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umeranjum17/byokit.git",
    "directory": "packages/machine"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
