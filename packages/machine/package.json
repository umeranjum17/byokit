        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssh": {
      "types": "./dist/ssh.d.ts",
      "default": "./dist/ssh.js"
    },
    "./idle": {
      "react-native": {
        "types": "./dist/idle.d.ts",
        "default": "./dist/idle.js"
      },
      "browser": {
        "types": "./dist/idle.d.ts",
        "default": "./dist/idle.js"
      },
      "types": "./dist/idle.d.ts",
      "default": "./dist/idle.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
