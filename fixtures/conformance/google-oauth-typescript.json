{
  "rule": "Google Cloud Code Assist sign-in, replayed offline for the two Google routes. Both clients authorize with PKCE S256 on Google's own authorization page (access_type=offline, prompt=consent), return to a loopback callback (google-gemini-cli on 127.0.0.1:8085 /oauth2callback, google-antigravity on 127.0.0.1:51121 /oauth-callback), exchange the code at the shared token endpoint and read the email from userinfo. After the exchange each client calls Cloud Code Assist (google-gemini-cli at cloudcode-pa.googleapis.com with the GEMINI metadata, google-antigravity at daily-cloudcode-pa.googleapis.com with ANTIGRAVITY) to load or provision a project. A refresh that the provider refuses answers invalid_grant; an individual account with no Code Assist tier answers ineligibleTiers and keeps nothing. Protocol facts are cited from the omp v18.4.10 snapshot cb0d5295; no client id, client secret or live sign-in is recorded here.",
  "now": 1800000000000,
  "token": "https://oauth2.googleapis.com/token",
  "userinfo": "https://www.googleapis.com/oauth2/v1/userinfo?alt=json",
  "clients": {
    "google-gemini-cli": {
      "authorize": "https://accounts.google.com/o/oauth2/v2/auth",
      "authorizeParams": { "access_type": "offline", "prompt": "consent" },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform",
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ],
      "callback": { "hostname": "127.0.0.1", "port": 8085, "path": "/oauth2callback" },
      "codeAssist": "https://cloudcode-pa.googleapis.com",
      "metadata": { "ideType": "IDE_UNSPECIFIED", "platform": "PLATFORM_UNSPECIFIED", "pluginType": "GEMINI" }
    },
    "google-antigravity": {
      "authorize": "https://accounts.google.com/o/oauth2/v2/auth",
      "authorizeParams": { "access_type": "offline", "prompt": "consent" },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform",
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile",
        "https://www.googleapis.com/auth/cclog",
        "https://www.googleapis.com/auth/experimentsandconfigs"
      ],
      "callback": { "hostname": "127.0.0.1", "port": 51121, "path": "/oauth-callback" },
      "codeAssist": "https://daily-cloudcode-pa.googleapis.com",
      "metadata": { "ideType": "ANTIGRAVITY" }
    }
  },
  "exchange": { "access_token": "recorded-access", "refresh_token": "recorded-refresh", "expires_in": 3600, "scope": "https://www.googleapis.com/auth/cloud-platform", "token_type": "Bearer" },
  "rotation": { "access_token": "rotated-access", "refresh_token": "rotated-refresh", "expires_in": 7200, "token_type": "Bearer" },
  "invalidGrant": { "error": "invalid_grant", "error_description": "Token has been expired or revoked." },
  "userinfoBody": { "email": "umer@example.com", "verified_email": true },
  "eligible": { "cloudaicompanionProject": "recorded-project", "currentTier": { "id": "standard-tier" } },
  "provision": {
    "loadCodeAssist": { "allowedTiers": [ { "id": "free-tier", "isDefault": true } ] },
    "onboardUser": { "name": "operations/recorded-onboard", "done": false },
    "operation": { "name": "operations/recorded-onboard", "done": true, "response": { "cloudaicompanionProject": { "id": "recorded-project" } } }
  },
  "ineligible": {
    "ineligibleTiers": [
      { "tierId": "free-tier", "reasonMessage": "This account is not eligible for Code Assist.", "validationUrl": "https://accounts.google.com/signin" }
    ]
  }
}
